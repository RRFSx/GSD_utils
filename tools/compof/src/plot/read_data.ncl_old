
  datemm = fbinrecread(filedata, 0, (/2/), "integer")
  print("   date="+datemm(0) + "     minute="+datemm(1))
  numvar=dim(2)
  nfcst=dim(1)
  numstation=dim(3)
  nlvl=dim(0)

  rmse   = fbinrecread(filedata, 1, (/ numstation,nfcst,nlvl,numvar /), "float")
  bias   = fbinrecread(filedata, 2, (/ numstation,nfcst,nlvl,numvar /), "float")
  numpair= fbinrecread(filedata, 3, (/ numstation,nfcst,nlvl,numvar /), "integer")

  if( numtimelevel .gt. 0 ) then
     do i = 1 , numtimelevel-1
        datemm = fbinrecread(filedata, 0 + i*4, (/2/), "integer")
        print("   date="+datemm(0) + "     minute="+datemm(1))
        rmse   = fbinrecread(filedata, 1 + i*4, (/ numstation,nfcst,nlvl,numvar /), "float")
        bias   = fbinrecread(filedata, 2 + i*4, (/ numstation,nfcst,nlvl,numvar /), "float")
        numpair= fbinrecread(filedata, 3 + i*4, (/ numstation,nfcst,nlvl,numvar /), "integer")
     end do
  end if
; numstation,nfcst,nlvl,numvar

